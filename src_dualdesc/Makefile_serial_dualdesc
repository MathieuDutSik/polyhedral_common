PROGRAM		= POLY_SerialDualDesc

SRCFILES	=
OBJECTS		= $(SRCFILES:.cpp=.o) $(PROGRAM:%=%.o)
LINKOBJECTS	= $(SRCFILES:.cpp=.o)

CC		= g++ -std=c++20 -Wall -O3 -g

NOLINKFLAG 	= -c
OUTPUTFLAG 	= -o

#COPTIONS        = -DPERMUTALIB_BLOCKING_SANITY_CHECK
#COPTIONS        = -DTIMINGS
#COPTIONS        =
COPTIONS        = -DGMP_POOL -DDEBUG_DUAL_DESC

CHASHMAP        = -I../basic_common_cpp/sparse-map/include/tsl/ -I../basic_common_cpp/robin-map/include/tsl/ -I../basic_common_cpp/hopscotch-map/include/tsl/

CLOCAL          = -I../src_basic -I../basic_common_cpp   -I../src_number -I../src_matrix -I../src_comb -I../src_group -I../src_graph -I../src_latt -I../src_poly -I../src_perfect -I../permutalib/src -I../src_lorentzian -I../src_isotropy -I.

CFLAGS 		= -I$(GMP_INCDIR) -I$(LIBBLISS_INCDIR) -I$(BOOST_INCDIR) -isystem $(EIGEN_PATH) $(NAUTY_INCLUDE) -DEIGEN_NO_DEBUG

CTOTAL		= $(CHASHMAP) $(CLOCAL) $(CFLAGS) $(COPTIONS)

LIBS		= -lm $(GMP_CXX_LINK) -pthread $(LIBBLISS_LINK) $(BOOST_LINK) $(NAUTY_LINK)


%.o: %.cpp
	@echo
	@echo compile $<
	$(CC) $(OUTPUTFLAG) $@ $(CTOTAL) $(NOLINKFLAG) $<

all:	$(PROGRAM)

$(PROGRAM): 	$(OBJECTS)
		@echo
		@echo link $@
		$(CC) $(LINKOBJECTS) $(DEBUGFLAG) $@.o $(LIBS) -o $@

clean:;
	rm -f *.o
	rm -f $(PROGRAM)

PROGRAM		= LATT_ComputeShortestOrbits

OBJECTS		= $(PROGRAM:%=%.o)

CC		= g++ -std=c++20 -Wall -Wextra -O3 -g

NOLINKFLAG 	= -c
CDEPS           = -MMD -MP
OUTPUTFLAG 	= -o

CHASHMAP        = -I../basic_common_cpp/sparse-map/include/tsl/ -I../basic_common_cpp/robin-map/include/tsl/ -I../basic_common_cpp/hopscotch-map/include/tsl/
CLOCAL          = -I../src_basic -I../src_number -I../src_matrix -I../src_lorentzian -I../src_graph -I../permutalib/src -I../src_comb -I../src_poly -I../src_group -I../src_dualdesc -I../src_short -I../src_isotropy -I../src_enum_schemes -I.
COPTIONS        = -DGMP_POOL


CFLAGS 		= -I$(GMP_INCDIR) -I$(BOOST_INCDIR) -isystem $(EIGEN_PATH) $(NAUTY_INCLUDE)

CTOTAL          = $(CLOCAL) $(CFLAGS) $(CHASHMAP) $(COPTIONS)
LIBS		= -lm $(GMP_CXX_LINK) -pthread $(NAUTY_LINK)

%.o: %.cpp
	@echo
	@echo compile $<
	$(CC) $(OUTPUTFLAG) $@ $(CTOTAL) $(CDEPS) $(NOLINKFLAG) $<

all:	$(PROGRAM)

$(PROGRAM): 	$(OBJECTS)
		@echo
		@echo link $@
		$(CC) $(DEBUGFLAG) $@.o $(LIBS) -o $@

clean:;
	rm -f *.o
	rm -f *.d
	rm -f $(PROGRAM)

# The header dependencies, written by the compiler as it compiles (-MMD),
# so that a change to a header rebuilds the objects that include it.
-include $(OBJECTS:.o=.d)
